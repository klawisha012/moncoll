# Example environment variables for Angie

# Path to the Angie binary executable
ANGIE_BINARY=your_angie_binary

# Path to the Angie configuration template file
ANGIE_CONFIG_TEMPLATE=/etc/angie/angie.conf.t

# Severity level for error logging (e.g., debug, info, notice, warn, error)
ANGIE_ERROR_LOG_SEVERITY=notice

# Enable or disable the reload feature (on/off)
ANGIE_FEATURE_RELOAD=on

# Enable or disable the template feature (on/off)
ANGIE_FEATURE_TEMPLATE=on

# Comma-separated list of modules to load (e.g., lua, geoip)
ANGIE_LOAD_MODULES=your_modules

# Path to the Angie PID file
ANGIE_PID_FILE=/run/angie/angie.pid

# Number of worker connections
ANGIE_WORKER_CONNECTIONS=65536

# Limit on the number of open files for worker processes
ANGIE_WORKER_RLIMIT_NOFILE=65536