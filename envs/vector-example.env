# Example environment variables for Vector
# Path to the Vector configuration file. Supports wildcards and multiple files.
VECTOR_CONFIG=<path_to_config>

# Vector's log level. Options: DEBUG, INFO, WARN, ERROR, TRACE
VECTOR_LOG=<log_level>

# Set the logging format. Options: text, json
VECTOR_LOG_FORMAT=<format>

# Control when ANSI terminal formatting is used. Options: always, auto, never
VECTOR_COLOR=<color_setting>

# Watch for changes in the configuration file and reload accordingly
VECTOR_WATCH_CONFIG=<true_or_false>

# Exit on startup if any sinks fail healthchecks
VECTOR_REQUIRE_HEALTHY=<true_or_false>

# Set the duration in seconds to wait for graceful shutdown after SIGINT or SIGTERM
VECTOR_GRACEFUL_SHUTDOWN_LIMIT_SECS=<seconds>

# Set the internal log rate limit
VECTOR_INTERNAL_LOG_RATE_LIMIT=<rate>

# Method for watching config files. Options: recommended, poll
VECTOR_WATCH_CONFIG_METHOD=<method>

# Poll for config changes at given interval (only if poll method)
VECTOR_WATCH_CONFIG_POLL_INTERVAL_SECONDS=<seconds>

# Turn on strict mode for environment variable interpolation
VECTOR_STRICT_ENV_VARS=<true_or_false>

# Allow the configuration to run without any components
VECTOR_ALLOW_EMPTY_CONFIG=<true_or_false>

# Never time out while waiting for graceful shutdown
VECTOR_NO_GRACEFUL_SHUTDOWN_LIMIT=<true_or_false>

# Disable probing and configuration of root certificate locations for OpenSSL
VECTOR_OPENSSL_NO_PROBE=<true_or_false>

# Read configuration from files in one or more directories
VECTOR_CONFIG_DIR=<directory>

# Read configuration from JSON files
VECTOR_CONFIG_JSON=<json_files>

# Read configuration from TOML files
VECTOR_CONFIG_TOML=<toml_files>

# Read configuration from YAML files
VECTOR_CONFIG_YAML=<yaml_files>

# Overrides the hostname used in Vector's logs and metrics
VECTOR_HOSTNAME=<hostname>

# The number of threads to use for processing
VECTOR_THREADS=<number>

# ClickHouse endpoint URL
CLICKHOUSE_ENDPOINT=<endpoint>

# ClickHouse username
CLICKHOUSE_USER=<username>

# ClickHouse password
CLICKHOUSE_PASSWORD=<password>

# ClickHouse database name
CLICKHOUSE_DB=<database>