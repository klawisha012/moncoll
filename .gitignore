Thumbs.db

# CrowdSec — runtime data is managed by the container (bind-mounted
# into ./configs/crowdsec/ and ./var/log/crowdsec/), so the whole tree
# stays out of git. Keep the backend Python module tracked.
# An unscoped `crowdsec/` previously swallowed backend/src/crowdsec/ on CI.
/var/log/crowdsec/
/configs/crowdsec/
# Only the .py sources of the Python module are tracked — never its bytecode
# or runtime artefacts.
!backend/src/crowdsec/
!backend/src/crowdsec/*.py

# WAF runtime TLS material (generated by backend ACME/self-signed flow).
# These were historically committed by accident; never commit new ones.
configs/angie/http.d/conn_*/
configs/angie/http.d/*.key
configs/angie/http.d/*.crt
configs/angie/acme/

# Local curl session jars
cookies.txt
*.cookies.txt

# Gitleaks report artefact (uploaded as a build artefact, not committed)
.gitleaks-report.json

vllm
# (Previously a blanket `Dockerfile` ignore lived here — removed because it
#  would hide any new top-level Dockerfile from git.)

