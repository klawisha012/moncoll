# Environment
.env
.env.local
.env.*.local
envs/*.env
!envs/*-example.env
# AI
.ai/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# Node / Frontend
node_modules/
dist/
*.tsbuildinfo

# Go build artifacts (the server binary is built inside the Docker image)
/gobackend/server

# Logs
*.log
var/log/

# WAF runtime state (live backend artefacts, not source)
/var/compose/
/var/site-templates/
/var/mode4.json
/docker/angie/http.d/blocked_ips.*
# Rendered CrowdSec bouncer config — generated by scripts/generate-env.sh
# from crowdsec-nginx-bouncer.conf.template; contains the bouncer API key
# which is .env-sourced and must never be committed. See commit 88dfb72
# for why this exists.
/docker/angie/bouncers/crowdsec-nginx-bouncer.conf
# Local design-audit artefacts (screenshots, mockups)
/var/design-audit/

# Temporary files
temp/
tmp/

# Test artifacts
test_output/
test_results/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# CrowdSec — runtime data is managed by the container (bind-mounted
# into ./docker/crowdsec/ and ./var/log/crowdsec/), so the whole tree
# stays out of git. Keep the backend Python module tracked.
# An unscoped `crowdsec/` previously swallowed backend/src/crowdsec/ on CI.
/var/log/crowdsec/
/docker/crowdsec/
# Only the .py sources of the Python module are tracked — never its bytecode
# or runtime artefacts.
!backend/src/crowdsec/
!backend/src/crowdsec/*.py

# Remotion (isolated video workspace)
remotion/node_modules/
remotion/out/
remotion/.remotion/
remotion/.captures/

# WAF runtime TLS material (generated by backend ACME/self-signed flow).
# These were historically committed by accident; never commit new ones.
docker/angie/http.d/conn_*/
docker/angie/http.d/*.key
docker/angie/http.d/*.crt
docker/angie/http.d/**/*.key
docker/angie/http.d/**/*.crt
docker/angie/http.d/**/*.pem
docker/angie/acme/

# Local curl session jars
cookies.txt
*.cookies.txt

# Gitleaks report artefact (uploaded as a build artefact, not committed)
.gitleaks-report.json

vllm
# (Previously a blanket `Dockerfile` ignore lived here — removed because it
#  would hide any new top-level Dockerfile from git.)

# Docs (local design/plan notes, not source)
docs/

# AI
.roo
.roo/
.claude/
CLAUDE.md
GEMINI.md
.mcp.json
.playwright-mcp/
.gstack/
