{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "WAF — Сходимость горизонтального масштабирования",
  "uid": "waf-scaling-converge",
  "tags": ["waf", "scaling"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Применённое vs опубликованное поколение",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "max(state_published_generation)",
          "legendFormat": "опубликовано"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "edge_sync_applied_generation",
          "legendFormat": "применено {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Отставание сходимости (поколений позади)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "edge_sync:lag_generations",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ошибки edge-sync (частота)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "rate(edge_sync_errors_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
