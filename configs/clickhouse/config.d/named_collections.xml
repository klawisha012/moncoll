<!--
  PostgreSQL credentials for ClickHouse postgresql() table function.

  Reads POSTGRES_USER, POSTGRES_DB, POSTGRES_PASSWORD from the ClickHouse
  container's environment (docker-compose.yml passes them through from .env).

  Used by logs.connection_domains in init.sql:

      FROM postgresql(postgres_waf, table='connections')

  Why this exists: shipping waf:waf as the hardcoded fallback let any
  process on the docker network dump the connections table (and pivot to
  the users table since they share a Postgres user). Hardcoding the
  random password baked by scripts/generate-env.sh into init.sql also
  worked once, then broke the moment .env was regenerated.
  See .gstack/security-reports/2026-05-20-043200.json F3.
-->
<clickhouse>
    <named_collections>
        <postgres_waf>
            <host>postgres</host>
            <port>5432</port>
            <user from_env="POSTGRES_USER"/>
            <password from_env="POSTGRES_PASSWORD"/>
            <database from_env="POSTGRES_DB"/>
        </postgres_waf>
    </named_collections>
</clickhouse>
