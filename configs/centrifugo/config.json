{
  "log": {
    "level": "info"
  },

  "http_server": {
    "address": "0.0.0.0",
    "port": 8000
  },

  "client": {
    "allowed_origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },

  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis:6379"
    }
  },

  "websocket": {
    "compression": false,
    "use_write_buffer_pool": true
  },

  "channel": {
    "namespaces": [
      {
        "name": "dashboard",
        "presence": false,
        "history_size": 0,
        "history_ttl": "0s",
        "force_recovery": false,
        "join_leave": false,
        "allow_subscribe_for_client": true
      }
    ]
  }
}
